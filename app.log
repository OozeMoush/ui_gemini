# test_qlora_setup.py
import torch
from transformers import AutoModelForCausalLM, BitsAndBytesConfig
import logging
import os

# Set environment variable for CUDA path (adjust if necessary)
# This might help bitsandbytes find the correct CUDA libraries
# os.environ['CUDA_PATH'] = "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v11.8" # Example path, adjust as needed

# Enable detailed logging for transformers and bitsandbytes
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

print("--- QLoRA Setup Test Script ---")
print(f"PyTorch version: {torch.__version__}")
print(f"CUDA available: {torch.cuda.is_available()}")
if torch.cuda.is_available():
    print(f"CUDA version: {torch.version.cuda}")
    print(f"Device count: {torch.cuda.device_count()}")
    print(f"Current device: {torch.cuda.current_device()}")
    print(f"Device name: {torch.cuda.get_device_name(torch.cuda.current_device())}")

# Define BitsAndBytesConfig for 4-bit quantization
# NF4 quantization with bfloat16 compute type is common for QLoRA
bnb_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_use_double_quant=True, # Optional, can improve precision slightly
    bnb_4bit_quant_type="nf4",      # Recommended quantization type
    bnb_4bit_compute_dtype=torch.bfloat16 # Recommended compute type for QLoRA
)
logger.info(f"BitsAndBytesConfig created: {bnb_config}")

# Choose a small, readily available model for testing
model_id = "gpt2"
print(f"\nAttempting to load model '{model_id}' with 4-bit quantization...")

try:
    # Load the model with the specified quantization config
    # device_map="auto" lets transformers handle device placement (GPU if available)
    model = AutoModelForCausalLM.from_pretrained(
        model_id,
        quantization_config=bnb_config,
        device_map="auto",
        trust_remote_code=True # Sometimes needed depending on the model
    )
    print("\n--- Model Loading Successful! ---")

    # Print some information about the loaded model
    print(f"Model class: {model.__class__.__name__}")
    print(f"Model is on device: {model.device}")
    # Note: get_memory_footprint might not accurately reflect the 4-bit quantized size immediately after loading
    # but it gives an idea of the loaded modules.
    try:
        footprint = model.get_memory_footprint()
        print(f"Model memory footprint: {footprint / (1024**3):.2f} GB")
    except Exception as mem_e:
        logger.warning(f"Could not get memory footprint: {mem_e}")

    # Verify that linear layers are replaced by bnb layers (e.g., Linear4bit)
    linear_layer_types = set()
    for name, module in model.named_modules():
        if isinstance(module, torch.nn.Linear):
            linear_layer_types.add(module.__class__.__name__)
        # Check specifically for bitsandbytes layers
        if "Linear" in module.__class__.__name__ and "bitsandbytes" in str(module.__class__):
             linear_layer_types.add(module.__class__.__name__)

    print(f"\nDetected linear layer types in the model: {linear_layer_types}")
    if any("4bit" in t.lower() for t in linear_layer_types):
        print("Found 4-bit quantized layers (e.g., Linear4bit). Bitsandbytes seems active.")
    else:
        print("WARNING: Did not find expected 4-bit layers. Quantization might not be applied correctly.")

except ImportError as ie:
    logger.error(f"Import Error during model loading: {ie}")
    logger.error("This might indicate an issue with bitsandbytes installation or CUDA setup.")
    logger.error("Ensure CUDA toolkit (compatible version, e.g., 11.8) is installed and PATH is set correctly.")
except Exception as e:
    logger.error(f"An unexpected error occurred during model loading: {e}", exc_info=True)
    logger.error("Check CUDA compatibility, driver version, and library installations.")

print("\n--- Test script finished. ---")

```

